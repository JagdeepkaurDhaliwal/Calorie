<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Permit cleartext HTTP for development IPs and local networks -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Debug overrides for local proxying and certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
